# Server-only. Enables the contact form to email pradhuldev.1990@gmail.com via Resend.
# If unset, the form shows a mailto fallback instead of failing silently.
RESEND_API_KEY=

# Optional. Verified Resend sender, e.g. "Pradhul Dev <hello@pradhul.dev>".
# If unset, the form sends from Resend's onboarding address.
RESEND_FROM=

# Optional. Resend `to` recipient. Defaults to the Resend account inbox
# pradhul.dev1990@gmail.com (test mode compares this literally).
# Public mailto on the site stays pradhuldev.1990@gmail.com.
CONTACT_TO_EMAIL=

# Public. Google Search Console HTML-tag verification token.
# If unset, no google-site-verification meta tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
